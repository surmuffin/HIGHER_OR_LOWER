            </section>

        </div>
    </div>

    <!-- CATEGORY SELECTION MODAL -->
    <div id="category-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden items-center justify-center p-4">
        <div class="bg-[#141210] border border-amber-500/30 rounded-3xl max-w-md w-full p-6 shadow-2xl relative animate-modal-pop">
            <div class="flex items-center justify-between pb-4 border-b border-white/10">
                <div>
                    <h3 class="text-lg font-extrabold text-white">Select Strata Realm</h3>
                    <p class="text-xs text-stone-400 font-mono">Filter comparison subjects by domain</p>
                </div>
                <button onclick="closeCategoryModal()" class="w-8 h-8 rounded-full bg-white/5 hover:bg-white/10 flex items-center justify-center text-stone-400 hover:text-white cursor-pointer">✕</button>
            </div>
            <div id="category-list" class="grid grid-cols-2 gap-2.5 pt-5">
                <!-- Populated dynamically -->
            </div>
        </div>
    </div>

    <!-- GAME OVER MODAL -->
    <div id="gameover-modal" class="fixed inset-0 z-50 bg-black/85 backdrop-blur-md hidden items-center justify-center p-4 overflow-y-auto">
        <div class="bg-[#141210] border border-rose-500/30 rounded-3xl max-w-lg w-full p-6 sm:p-8 shadow-[0_0_60px_rgba(244,63,94,0.25)] text-center space-y-5 animate-modal-pop my-auto">
            <!-- Header & Dynamic Record Badge -->
            <div class="relative">
                <div id="go-new-record-badge" class="hidden inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/20 border border-amber-400/50 text-amber-300 text-[10px] font-mono font-extrabold uppercase tracking-wider mb-3 shadow-[0_0_20px_rgba(245,158,11,0.4)] animate-bounce">
                    ★ New Expedition Record!
                </div>
                <div class="w-14 h-14 rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center mx-auto text-rose-400 font-black text-xl shadow-[0_0_30px_rgba(244,63,94,0.3)]">
                    ✕
                </div>
                <h3 class="text-2xl font-black text-white mt-3 tracking-tight">Expedition Halted</h3>
                <p id="go-comparison-summary" class="text-xs text-stone-400 mt-1.5 font-mono leading-relaxed"></p>
            </div>

            <!-- Current Run vs All-Time Best Grid -->
            <div class="grid grid-cols-2 gap-3 font-mono text-left">
                <!-- Current Run Card -->
                <div class="bg-white/[0.03] border border-white/[0.08] p-3.5 rounded-2xl space-y-2">
                    <span class="block text-[10px] uppercase font-bold text-stone-400 tracking-wider">This Dive</span>
                    <div class="flex items-baseline justify-between">
