        /**
         * ============================================================================
         * 3. GAME STATE & PERSISTENCE
         * ============================================================================
         */
        let selectedCategory = "All";
        let score = 0;
        let depth = 0;
        let targetDepth = 0;
        let visualDepth = 0;

        let bestScore = parseInt(localStorage.getItem('cave_hol_best')) || 0;
        let maxDepth = parseInt(localStorage.getItem('cave_hol_maxdepth')) || 0;
        let totalRuns = parseInt(localStorage.getItem('cave_hol_runs')) || 0;
        let runHistory = [];
        try {
            const savedRuns = JSON.parse(localStorage.getItem('cave_hol_history'));
            if (Array.isArray(savedRuns)) runHistory = savedRuns;
        } catch (e) {}
        let isNewRecordThisRun = false;

        let leftItem = null;
        let rightItem = null;
        let recentTitles = [];

        // State machine: 'playing' | 'revealing' | 'gameover'
        let gameState = 'playing';
        let revealFrame = 0;
        let lastGuessCorrect = false;

        // Visual feedback animations
        let screenShakeTimer = 0;
        let minerSwingTimer = 0;
        let sparkParticles = [];
        let cardSlideOffset = 0;

        // Interactive button bounding boxes calculated dynamically each frame
        let btnHigherRect = { x: 0, y: 0, w: 0, h: 0 };
        let btnLowerRect = { x: 0, y: 0, w: 0, h: 0 };
        let hoveredButton = null; // 'higher' | 'lower' | null

        function getPool() {
            if (selectedCategory === "All") return DATASET;
            return DATASET.filter(item => item.category === selectedCategory);
        }

        function pickNextItem(excludeItem) {
            const pool = getPool();
            let candidates = pool.filter(i => i.title !== excludeItem?.title && !recentTitles.includes(i.title));
            if (candidates.length === 0) {
                recentTitles = excludeItem ? [excludeItem.title] : [];
                candidates = pool.filter(i => i.title !== excludeItem?.title);
            }
            const chosen = candidates[Math.floor(Math.random() * candidates.length)];
            recentTitles.push(chosen.title);
            if (recentTitles.length > Math.floor(pool.length * 0.6)) {
                recentTitles.shift();
            }
            return chosen;
        }

        function updateHUD() {
            document.getElementById('hud-score').innerText = score;
            document.getElementById('hud-depth').innerText = depth + 'm';
            document.getElementById('hud-best').innerText = bestScore;

            let strataLabel = "Bedrock Strata";
            if (depth >= 300) strataLabel = "Magma Core";
            else if (depth >= 150) strataLabel = "Crystal Cavern";
            else if (depth >= 60) strataLabel = "Deep Ore Vein";

            document.getElementById('header-strata').innerText = `${strataLabel} • ${depth}m`;
        }

        function initGame() {
            score = 0;
            depth = 0;
            targetDepth = 0;
            isNewRecordThisRun = false;
            recentTitles = [];
            leftItem = pickNextItem(null);
            rightItem = pickNextItem(leftItem);
            gameState = 'playing';
            hoveredButton = null;
            updateHUD();
        }

        /**
         * ============================================================================
         * 4. CANVAS SETUP & SUBTERRANEAN ENVIRONMENT ENTITIES
         * ============================================================================
         */
        const canvas = document.getElementById('game-canvas');
        const ctx = canvas.getContext('2d');
        let width = window.innerWidth;
        let height = window.innerHeight;
        let dpr = Math.min(window.devicePixelRatio || 1, 2);

        let dustParticles = [];
        let crystalNodes = [];

        function resizeCanvas() {
            width = window.innerWidth;
            height = window.innerHeight;
            dpr = Math.min(window.devicePixelRatio || 1, 2);
            canvas.width = width * dpr;
            canvas.height = height * dpr;
            ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        }

        function initEnvironment() {
            dustParticles = [];
            for (let i = 0; i < 110; i++) {
                dustParticles.push({
                    x: Math.random() * 2000,
                    y: Math.random() * 3000,
                    r: Math.random() * 2.4 + 0.6,
                    vy: Math.random() * 0.35 + 0.1,
                    phase: Math.random() * Math.PI * 2,
                    alpha: Math.random() * 0.65 + 0.15,
                    color: ['#fbbf24', '#38bdf8', '#a855f7', '#34d399'][Math.floor(Math.random() * 4)]
                });
            }

            crystalNodes = [];
            for (let i = 0; i < 48; i++) {
                const isLeftWall = i % 2 === 0;
                crystalNodes.push({
                    side: isLeftWall ? 'left' : 'right',
                    offsetX: Math.random() * 140 + 20,
                    y: i * 190 + Math.random() * 80,
                    size: Math.random() * 18 + 10,
                    angle: (Math.random() - 0.5) * 0.7,
                    color: ['#f59e0b', '#38bdf8', '#a855f7', '#10b981', '#f43f5e'][i % 5]
                });
            }
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        initEnvironment();
        initGame();

        function spawnSparks(cx, cy, color, count = 28) {
            for (let i = 0; i < count; i++) {
                const angle = Math.random() * Math.PI * 2;
                const speed = Math.random() * 6 + 2;
                sparkParticles.push({
                    x: cx,
                    y: cy,
                    vx: Math.cos(angle) * speed,
                    vy: Math.sin(angle) * speed - 2,
                    life: 1.0,
                    decay: Math.random() * 0.025 + 0.018,
                    size: Math.random() * 3.5 + 1.5,
                    color: color
                });
            }
        }

        /**
         * ============================================================================
         * 5. INPUT HANDLING (MOUSE, TOUCH & KEYBOARD)
         * ============================================================================
         */
        function isPointInRect(px, py, rect) {
            return px >= rect.x && px <= rect.x + rect.w && py >= rect.y && py <= rect.y + rect.h;
        }

        function handlePointerMove(clientX, clientY) {
            if (gameState !== 'playing') {
                hoveredButton = null;
                canvas.style.cursor = 'default';
                return;
            }
            const rect = canvas.getBoundingClientRect();
            const mx = clientX - rect.left;
            const my = clientY - rect.top;

            if (isPointInRect(mx, my, btnHigherRect)) {
                hoveredButton = 'higher';
                canvas.style.cursor = 'pointer';
            } else if (isPointInRect(mx, my, btnLowerRect)) {
                hoveredButton = 'lower';
                canvas.style.cursor = 'pointer';
            } else {
                hoveredButton = null;
                canvas.style.cursor = 'default';
            }
        }

        function handlePointerAction(clientX, clientY) {
            ensureAudio();
            if (gameState !== 'playing') return;
            const rect = canvas.getBoundingClientRect();
            const mx = clientX - rect.left;
            const my = clientY - rect.top;

            if (isPointInRect(mx, my, btnHigherRect)) {
                submitGuess('higher');
            } else if (isPointInRect(mx, my, btnLowerRect)) {
                submitGuess('lower');
            }
        }

        canvas.addEventListener('mousemove', (e) => handlePointerMove(e.clientX, e.clientY));
        canvas.addEventListener('click', (e) => handlePointerAction(e.clientX, e.clientY));
        canvas.addEventListener('touchstart', (e) => {
            if (e.touches.length > 0) {
                const t = e.touches[0];
                handlePointerMove(t.clientX, t.clientY);
                handlePointerAction(t.clientX, t.clientY);
            }
        }, { passive: true });

        window.addEventListener('keydown', (e) => {
            const anyModalOpen = !document.getElementById('landing-modal').classList.contains('hidden') ||
                                 !document.getElementById('category-modal').classList.contains('hidden') ||
                                 !document.getElementById('gameover-modal').classList.contains('hidden');
            if (anyModalOpen) return;

            if (gameState === 'playing') {
                if (e.key === 'ArrowUp' || e.key.toLowerCase() === 'w') {
                    e.preventDefault();
                    submitGuess('higher');
                } else if (e.key === 'ArrowDown' || e.key.toLowerCase() === 's') {
                    e.preventDefault();
                    submitGuess('lower');
                }
            }
        });

        function submitGuess(direction) {
            if (gameState !== 'playing') return;

            const isHigherOrEqual = rightItem.searches >= leftItem.searches;
            lastGuessCorrect = (direction === 'higher' && isHigherOrEqual) || (direction === 'lower' && !isHigherOrEqual);

            gameState = 'revealing';
            revealFrame = 0;
            hoveredButton = null;
            canvas.style.cursor = 'default';

            if (lastGuessCorrect) {
                playSfx('dig');
                score++;
                const depthGain = 24 + Math.floor(Math.random() * 14);
                depth += depthGain;
                targetDepth = depth;

                if (score > bestScore) {
                    bestScore = score;
                    isNewRecordThisRun = true;
                    localStorage.setItem('cave_hol_best', bestScore);
                }
                if (depth > maxDepth) {
                    maxDepth = depth;
                    isNewRecordThisRun = true;
                    localStorage.setItem('cave_hol_maxdepth', maxDepth);
                }
                updateHUD();

                // Trigger Miner Swing, Screen Shake & Ore Sparks
                minerSwingTimer = 38;
                screenShakeTimer = 22;
                const sparkColor = depth >= 300 ? '#f87171' : (depth >= 150 ? '#38bdf8' : '#fbbf24');
                spawnSparks(width / 2, Math.max(115, height * 0.16), sparkColor, 36);
            } else {
                playSfx('fail');
                screenShakeTimer = 26;
                totalRuns++;
                localStorage.setItem('cave_hol_runs', totalRuns);

                // Save this expedition into top runs log
                runHistory.push({
                    score: score,
                    depth: depth,
                    realm: selectedCategory,
                    timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                });
                runHistory.sort((a, b) => b.score - a.score || b.depth - a.depth);
                runHistory = runHistory.slice(0, 10);
                localStorage.setItem('cave_hol_history', JSON.stringify(runHistory));
            }
        }

        /**
         * ============================================================================
         * 6. VECTOR DRAWING HELPERS & MINER CHARACTER
         * ============================================================================
         */
        function drawRoundedRect(x, y, w, h, r) {
            const radius = Math.min(r, w / 2, h / 2);
            ctx.beginPath();
            ctx.moveTo(x + radius, y);
            ctx.lineTo(x + w - radius, y);
            ctx.quadraticCurveTo(x + w, y, x + w, y + radius);
            ctx.lineTo(x + w, y + h - radius);
            ctx.quadraticCurveTo(x + w, y + h, x + w - radius, y + h);
            ctx.lineTo(x + radius, y + h);
            ctx.quadraticCurveTo(x, y + h, x, y + h - radius);
            ctx.lineTo(x, y + radius);
            ctx.quadraticCurveTo(x, y, x + radius, y);
            ctx.closePath();
        }

        function wrapText(text, x, y, maxWidth, lineHeight, maxLines = 2) {
            const words = text.split(' ');
            let line = '';
            let lines = [];

            for (let n = 0; n < words.length; n++) {
                const testLine = line + words[n] + ' ';
                const metrics = ctx.measureText(testLine);
                if (metrics.width > maxWidth && n > 0) {
                    lines.push(line.trim());
                    line = words[n] + ' ';
                } else {
                    line = testLine;
                }
            }
            lines.push(line.trim());

            if (lines.length > maxLines) {
                lines = lines.slice(0, maxLines);
                lines[maxLines - 1] = lines[maxLines - 1].replace(/.{3}$/, '...');
            }

            lines.forEach((l, idx) => {
                ctx.fillText(l, x, y + idx * lineHeight);
            });
            return lines.length;
        }

        function drawCrystalCluster(cx, cy, size, angle, color) {
            ctx.save();
            ctx.translate(cx, cy);
            ctx.rotate(angle);
            ctx.shadowColor = color;
            ctx.shadowBlur = 22;

            // Main crystal shard
            ctx.fillStyle = color;
            ctx.beginPath();
            ctx.moveTo(0, -size);
            ctx.lineTo(size * 0.45, -size * 0.2);
            ctx.lineTo(size * 0.3, size * 0.7);
            ctx.lineTo(-size * 0.3, size * 0.7);
            ctx.lineTo(-size * 0.45, -size * 0.2);
            ctx.closePath();
            ctx.fill();

            // Inner specular highlight
            ctx.fillStyle = 'rgba(255,255,255,0.45)';
            ctx.beginPath();
            ctx.moveTo(0, -size * 0.85);
            ctx.lineTo(size * 0.18, -size * 0.15);
            ctx.lineTo(0, size * 0.5);
            ctx.closePath();
            ctx.fill();

            ctx.restore();
        }

        function drawExpeditionMiner(cx, cy) {
            ctx.save();
            const bobY = Math.sin(Date.now() * 0.0045) * 4;
            ctx.translate(cx, cy + bobY);

            // Headlamp Cone Beam
            const beamGrad = ctx.createRadialGradient(0, -10, 4, 0, 15, 110);
            beamGrad.addColorStop(0, 'rgba(251, 191, 36, 0.32)');
            beamGrad.addColorStop(1, 'rgba(251, 191, 36, 0)');
            ctx.fillStyle = beamGrad;
            ctx.beginPath();
            ctx.moveTo(0, -14);
            ctx.lineTo(-75, 85);
            ctx.lineTo(75, 85);
            ctx.closePath();
            ctx.fill();

            // Miner Hardhat Dome
            ctx.fillStyle = '#f59e0b';
            ctx.shadowColor = 'rgba(245, 158, 11, 0.5)';
            ctx.shadowBlur = 15;
            ctx.beginPath();
            ctx.arc(0, -8, 16, Math.PI, 0);
            ctx.fill();

            // Hardhat Brim
            ctx.fillStyle = '#d97706';
            drawRoundedRect(-20, -9, 40, 5, 2.5);
            ctx.fill();

            // Glowing Headlamp
            ctx.fillStyle = '#fef08a';
            ctx.shadowColor = '#fef08a';
            ctx.shadowBlur = 16;
            ctx.beginPath();
            ctx.arc(0, -15, 4.5, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;

            // Animated Swinging Pickaxe
            let swingAngle = -0.35 + Math.sin(Date.now() * 0.005) * 0.1;
            if (minerSwingTimer > 0) {
                const t = 1 - (minerSwingTimer / 38);
                // Wind up then smash down
                swingAngle = t < 0.35
                    ? -0.35 - (t / 0.35) * 0.85
                    : -1.2 + ((t - 0.35) / 0.65) * 2.1;
                minerSwingTimer--;
            }

            ctx.save();
            ctx.translate(14, 2);
            ctx.rotate(swingAngle);

            // Pickaxe Wooden Handle
            ctx.strokeStyle = '#b45309';
            ctx.lineWidth = 4;
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(0, 14);
            ctx.lineTo(0, -22);
            ctx.stroke();

            // Pickaxe Steel Curved Head
            ctx.strokeStyle = '#e2e8f0';
            ctx.lineWidth = 4.5;
            ctx.beginPath();
            ctx.arc(0, -10, 18, Math.PI * 1.22, Math.PI * 1.78);
            ctx.stroke();

            ctx.restore();
            ctx.restore();
        }

        /**
         * ============================================================================
         * 7. MAIN RENDER LOOP
         * ============================================================================
         */
        function renderLoop() {
            visualDepth += (targetDepth - visualDepth) * 0.06;

            ctx.save();

            // Apply subtle seismic camera shake when triggered
            if (screenShakeTimer > 0) {
                const mag = (screenShakeTimer / 26) * 6;
                const sx = (Math.random() - 0.5) * mag * 2;
                const sy = (Math.random() - 0.5) * mag * 2;
                ctx.translate(sx, sy);
                screenShakeTimer--;
            }

            // 1. Strata Atmosphere Gradient
            let topColor = '#110d0b';
            let botColor = '#050404';
            let strataAccent = 'rgba(245, 158, 11, 0.12)';

            if (visualDepth >= 300) {
                topColor = '#1f0604';
                botColor = '#070101';
                strataAccent = 'rgba(239, 68, 68, 0.16)';
            } else if (visualDepth >= 150) {
                topColor = '#051522';
                botColor = '#02050a';
                strataAccent = 'rgba(56, 189, 248, 0.15)';
            } else if (visualDepth >= 60) {
                topColor = '#120d1d';
                botColor = '#040308';
                strataAccent = 'rgba(168, 85, 247, 0.14)';
            }

            const bgGrad = ctx.createLinearGradient(0, 0, 0, height);
            bgGrad.addColorStop(0, topColor);
            bgGrad.addColorStop(1, botColor);
            ctx.fillStyle = bgGrad;
            ctx.fillRect(0, 0, width, height);

            // 2. Organic Parallax Rock Strata Contours
            ctx.lineWidth = 2;
            ctx.strokeStyle = strataAccent;
            const spacing = 140;
            const scrollOffset = (visualDepth * 1.4) % spacing;

            for (let row = -1; row < Math.ceil(height / spacing) + 2; row++) {
                const baseY = row * spacing - scrollOffset;
                ctx.beginPath();
                for (let x = 0; x <= width + 40; x += 40) {
                    const wave = Math.sin(x * 0.008 + row * 1.3 + visualDepth * 0.015) * 18;
                    if (x === 0) ctx.moveTo(x, baseY + wave);
                    else ctx.lineTo(x, baseY + wave);
                }
                ctx.stroke();
            }

            // 3. Glowing Gemstone Clusters along Cavern Walls
            const loopHeight = 48 * 190;
            crystalNodes.forEach(node => {
                let rawY = (node.y - visualDepth * 1.8) % loopHeight;
                if (rawY < -60) rawY += loopHeight;
                if (rawY > -60 && rawY < height + 60) {
                    const cx = node.side === 'left'
                        ? Math.min(node.offsetX, width * 0.12)
                        : width - Math.min(node.offsetX, width * 0.12);
                    const pulseSize = node.size * (1 + Math.sin(Date.now() * 0.003 + node.y) * 0.08);
                    drawCrystalCluster(cx, rawY, pulseSize, node.angle, node.color);
                }
            });

            // 4. Floating Mineral Dust Motes
            dustParticles.forEach(p => {
                p.y -= p.vy;
                if (p.y < 0) p.y += 3000;
                const screenX = (p.x + Math.sin(Date.now() * 0.001 + p.phase) * 16) % width;
                const screenY = ((p.y - visualDepth * 1.1) % height + height) % height;

                ctx.save();
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.alpha;
                ctx.beginPath();
                ctx.arc(screenX, screenY, p.r, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            });

            // 5. Responsive Card Layout Geometry (Desktop Side-by-Side vs Mobile Stacked)
            const isMobile = width < 768;
            const headerSafeTop = isMobile ? 74 : 88;
            const footerSafeBottom = 46;
            const availHeight = height - headerSafeTop - footerSafeBottom;

            // Draw Expedition Miner above the cards
            const minerY = isMobile
                ? headerSafeTop + 26
                : Math.max(headerSafeTop + 28, (height / 2) - 195);
            drawExpeditionMiner(width / 2, minerY);

            // 6. Spark Particles (Rendered over miner)
            for (let i = sparkParticles.length - 1; i >= 0; i--) {
                const sp = sparkParticles[i];
                sp.x += sp.vx;
                sp.y += sp.vy;
                sp.vy += 0.18; // gravity
                sp.life -= sp.decay;

                if (sp.life <= 0) {
                    sparkParticles.splice(i, 1);
                    continue;
                }
                ctx.save();
                ctx.fillStyle = sp.color;
                ctx.shadowColor = sp.color;
                ctx.shadowBlur = 10;
                ctx.globalAlpha = sp.life;
                ctx.beginPath();
                ctx.arc(sp.x, sp.y, sp.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }

            // Compute Card Dimensions
            let leftRect, rightRect;
            if (isMobile) {
                const cardW = Math.min(420, width - 32);
                const cardX = (width - cardW) / 2;
                const topZone = minerY + 34;
                const remainingH = height - topZone - footerSafeBottom;
                const gap = 14;
                const cardH = Math.min(220, Math.max(165, (remainingH - gap) / 2));

                leftRect = { x: cardX, y: topZone, w: cardW, h: cardH };
                rightRect = { x: cardX, y: topZone + cardH + gap, w: cardW, h: cardH };
            } else {
                const gap = 56;
                const cardW = Math.min(390, (width - 80 - gap) / 2);
                const cardH = Math.min(310, Math.max(250, availHeight * 0.62));
                const centerY = Math.max(minerY + 46, (height - cardH) / 2 + 24);

                leftRect = { x: (width / 2) - cardW - (gap / 2), y: centerY, w: cardW, h: cardH };
                rightRect = { x: (width / 2) + (gap / 2), y: centerY, w: cardW, h: cardH };
            }

            // Smooth slide-in animation for new right card
            if (cardSlideOffset > 0.5) {
                cardSlideOffset *= 0.82;
            } else {
                cardSlideOffset = 0;
            }

            // Render Left Card (Known Item)
            drawKnownCard(leftRect, leftItem, isMobile);

            // Render Right Card (Target Item)
            const animatedRightRect = {
                x: rightRect.x + (isMobile ? 0 : cardSlideOffset),
                y: rightRect.y + (isMobile ? cardSlideOffset : 0),
                w: rightRect.w,
                h: rightRect.h
            };

            if (gameState === 'playing') {
                drawInteractiveRightCard(animatedRightRect, rightItem, leftItem, isMobile);
            } else if (gameState === 'revealing' || gameState === 'gameover') {
                if (gameState === 'revealing') {
                    revealFrame++;
                }
                const countUpFrames = 105; // Slower ~1.75s count-up so players can watch the numbers climb clearly
                const holdFrames = 55;     // Extra pause at final value so players can compare both numbers side-by-side
                const progress = Math.min(1, revealFrame / countUpFrames);
                // Smooth quintic ease-out for dramatic slowdown near the final digits
                const eased = 1 - Math.pow(1 - progress, 4);
                const displayedSearches = Math.floor(eased * rightItem.searches);

                drawRevealedRightCard(animatedRightRect, rightItem, displayedSearches, progress >= 1 ? lastGuessCorrect : null, isMobile);

                if (gameState === 'revealing' && revealFrame >= countUpFrames + holdFrames) {
                    if (lastGuessCorrect) {
                        leftItem = rightItem;
                        rightItem = pickNextItem(leftItem);
                        cardSlideOffset = 45;
                        gameState = 'playing';
                    } else {
                        gameState = 'gameover';
                        showGameOverModal();
                    }
                }
            }

            // Render Central VS / Result Badge
            const badgeX = isMobile ? width / 2 : (leftRect.x + leftRect.w + rightRect.x) / 2;
            const badgeY = isMobile ? (leftRect.y + leftRect.h + rightRect.y) / 2 : leftRect.y + leftRect.h / 2;
            drawCenterBadge(badgeX, badgeY, isMobile ? 20 : 26);

            ctx.restore();
            requestAnimationFrame(renderLoop);
        }

        function drawKnownCard(rect, item, isMobile) {
            ctx.save();
            // Glassmorphic Card Base
            ctx.fillStyle = 'rgba(20, 18, 16, 0.92)';
            ctx.shadowColor = 'rgba(0, 0, 0, 0.75)';
            ctx.shadowBlur = 32;
            ctx.shadowOffsetY = 12;
            drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 24);
            ctx.fill();
            ctx.shadowBlur = 0;
            ctx.shadowOffsetY = 0;

            // Subtle Border
            ctx.strokeStyle = 'rgba(245, 158, 11, 0.25)';
            ctx.lineWidth = 1.5;
            ctx.stroke();

            // Top Accent Stripe
            ctx.save();
            drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 24);
            ctx.clip();
            ctx.fillStyle = item.color;
            ctx.fillRect(rect.x, rect.y, rect.w, 5);
            ctx.restore();

            const pad = isMobile ? 20 : 28;

            // Category Pill
            ctx.font = '700 11px "JetBrains Mono", monospace';
            const catText = item.category.toUpperCase();
            const catW = ctx.measureText(catText).width + 20;
            ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
            drawRoundedRect(rect.x + pad, rect.y + pad, catW, 24, 12);
            ctx.fill();
            ctx.fillStyle = item.color;
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText(catText, rect.x + pad + 10, rect.y + pad + 12);

            // Title
            ctx.fillStyle = '#ffffff';
            ctx.font = isMobile ? '800 22px "Plus Jakarta Sans", sans-serif' : '800 30px "Plus Jakarta Sans", sans-serif';
            ctx.textBaseline = 'top';
            wrapText(item.title, rect.x + pad, rect.y + pad + 34, rect.w - pad * 2, isMobile ? 26 : 36, 2);

            // Label & Monthly Searches Number
            const bottomY = rect.y + rect.h - pad;
            ctx.fillStyle = '#a8a29e';
            ctx.font = '600 11px "JetBrains Mono", monospace';
            ctx.textBaseline = 'bottom';
            ctx.fillText('MONTHLY SEARCHES', rect.x + pad, bottomY - (isMobile ? 28 : 38));

            ctx.fillStyle = '#fbbf24';
            ctx.font = isMobile ? '800 24px "JetBrains Mono", monospace' : '800 32px "JetBrains Mono", monospace';
            ctx.fillText(item.searches.toLocaleString(), rect.x + pad, bottomY);

            ctx.restore();
        }

        function drawInteractiveRightCard(rect, item, compareItem, isMobile) {
            ctx.save();
            // Glassmorphic Card Base
            ctx.fillStyle = 'rgba(20, 18, 16, 0.92)';
            ctx.shadowColor = 'rgba(0, 0, 0, 0.75)';
            ctx.shadowBlur = 32;
            ctx.shadowOffsetY = 12;
            drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 24);
            ctx.fill();
            ctx.shadowBlur = 0;
            ctx.shadowOffsetY = 0;

            // Subtle Border
            ctx.strokeStyle = 'rgba(245, 158, 11, 0.25)';
            ctx.lineWidth = 1.5;
            ctx.stroke();

            // Top Accent Stripe
            ctx.save();
            drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 24);
            ctx.clip();
            ctx.fillStyle = item.color;
            ctx.fillRect(rect.x, rect.y, rect.w, 5);
            ctx.restore();

            const pad = isMobile ? 20 : 28;

            // Category Pill
            ctx.font = '700 11px "JetBrains Mono", monospace';
            const catText = item.category.toUpperCase();
            const catW = ctx.measureText(catText).width + 20;
            ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
            drawRoundedRect(rect.x + pad, rect.y + pad, catW, 24, 12);
            ctx.fill();
            ctx.fillStyle = item.color;
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText(catText, rect.x + pad + 10, rect.y + pad + 12);

            // Title
            ctx.fillStyle = '#ffffff';
            ctx.font = isMobile ? '800 22px "Plus Jakarta Sans", sans-serif' : '800 30px "Plus Jakarta Sans", sans-serif';
            ctx.textBaseline = 'top';
            wrapText(item.title, rect.x + pad, rect.y + pad + 34, rect.w - pad * 2, isMobile ? 26 : 36, 2);

            // Comparison Prompt
            const btnH = isMobile ? 42 : 48;
            const btnY = rect.y + rect.h - pad - btnH;
            ctx.fillStyle = '#a8a29e';
            ctx.font = '600 11px "JetBrains Mono", monospace';
            ctx.textBaseline = 'bottom';
            const promptText = `THAN ${compareItem.title.toUpperCase()}`;
            ctx.fillText(promptText, rect.x + pad, btnY - 10);

            // Higher & Lower Interactive Button Zones
            const btnGap = 12;
            const btnW = (rect.w - pad * 2 - btnGap) / 2;

            btnHigherRect = { x: rect.x + pad, y: btnY, w: btnW, h: btnH };
            btnLowerRect = { x: rect.x + pad + btnW + btnGap, y: btnY, w: btnW, h: btnH };

            // Draw Higher Button
            const hoverHigh = hoveredButton === 'higher';
            ctx.fillStyle = hoverHigh ? 'rgba(245, 158, 11, 0.25)' : 'rgba(245, 158, 11, 0.12)';
            ctx.strokeStyle = hoverHigh ? '#fbbf24' : 'rgba(245, 158, 11, 0.45)';
            ctx.lineWidth = hoverHigh ? 2 : 1.5;
            if (hoverHigh) {
                ctx.shadowColor = 'rgba(245, 158, 11, 0.35)';
                ctx.shadowBlur = 16;
            }
            drawRoundedRect(btnHigherRect.x, btnHigherRect.y, btnHigherRect.w, btnHigherRect.h, 14);
            ctx.fill();
            ctx.stroke();
            ctx.shadowBlur = 0;

            ctx.fillStyle = '#fbbf24';
            ctx.font = '800 13px "Plus Jakarta Sans", sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText('▲ HIGHER', btnHigherRect.x + btnHigherRect.w / 2, btnHigherRect.y + btnHigherRect.h / 2);

            // Draw Lower Button
            const hoverLow = hoveredButton === 'lower';
            ctx.fillStyle = hoverLow ? 'rgba(244, 63, 94, 0.25)' : 'rgba(244, 63, 94, 0.12)';
            ctx.strokeStyle = hoverLow ? '#fb7185' : 'rgba(244, 63, 94, 0.45)';
            ctx.lineWidth = hoverLow ? 2 : 1.5;
            if (hoverLow) {
                ctx.shadowColor = 'rgba(244, 63, 94, 0.35)';
                ctx.shadowBlur = 16;
            }
            drawRoundedRect(btnLowerRect.x, btnLowerRect.y, btnLowerRect.w, btnLowerRect.h, 14);
            ctx.fill();
            ctx.stroke();
            ctx.shadowBlur = 0;

            ctx.fillStyle = '#fb7185';
            ctx.fillText('▼ LOWER', btnLowerRect.x + btnLowerRect.w / 2, btnLowerRect.y + btnLowerRect.h / 2);

            ctx.restore();
        }

        function drawRevealedRightCard(rect, item, displayedSearches, resultStatus, isMobile) {
            ctx.save();
            let borderCol = 'rgba(245, 158, 11, 0.35)';
            let numCol = '#fbbf24';
            if (resultStatus === true) {
                borderCol = 'rgba(16, 185, 129, 0.65)';
                numCol = '#34d399';
            } else if (resultStatus === false) {
                borderCol = 'rgba(244, 63, 94, 0.65)';
                numCol = '#fb7185';
            }

            ctx.fillStyle = 'rgba(20, 18, 16, 0.94)';
            ctx.shadowColor = 'rgba(0, 0, 0, 0.8)';
            ctx.shadowBlur = 32;
            ctx.shadowOffsetY = 12;
            drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 24);
            ctx.fill();
            ctx.shadowBlur = 0;
            ctx.shadowOffsetY = 0;

            ctx.strokeStyle = borderCol;
            ctx.lineWidth = 2;
            ctx.stroke();

            // Top Accent Stripe
            ctx.save();
            drawRoundedRect(rect.x, rect.y, rect.w, rect.h, 24);
            ctx.clip();
            ctx.fillStyle = item.color;
            ctx.fillRect(rect.x, rect.y, rect.w, 5);
            ctx.restore();

            const pad = isMobile ? 20 : 28;

            // Category Pill
            ctx.font = '700 11px "JetBrains Mono", monospace';
            const catText = item.category.toUpperCase();
            const catW = ctx.measureText(catText).width + 20;
            ctx.fillStyle = 'rgba(255, 255, 255, 0.05)';
            drawRoundedRect(rect.x + pad, rect.y + pad, catW, 24, 12);
            ctx.fill();
            ctx.fillStyle = item.color;
            ctx.textAlign = 'left';
            ctx.textBaseline = 'middle';
            ctx.fillText(catText, rect.x + pad + 10, rect.y + pad + 12);

            // Title
            ctx.fillStyle = '#ffffff';
            ctx.font = isMobile ? '800 22px "Plus Jakarta Sans", sans-serif' : '800 30px "Plus Jakarta Sans", sans-serif';
            ctx.textBaseline = 'top';
            wrapText(item.title, rect.x + pad, rect.y + pad + 34, rect.w - pad * 2, isMobile ? 26 : 36, 2);

            // Count-Up Revealed Number
            const bottomY = rect.y + rect.h - pad;
            ctx.fillStyle = '#a8a29e';
            ctx.font = '600 11px "JetBrains Mono", monospace';
            ctx.textBaseline = 'bottom';
            ctx.fillText('MONTHLY SEARCHES', rect.x + pad, bottomY - (isMobile ? 28 : 38));

            ctx.fillStyle = numCol;
            ctx.font = isMobile ? '800 24px "JetBrains Mono", monospace' : '800 32px "JetBrains Mono", monospace';
            ctx.fillText(displayedSearches.toLocaleString(), rect.x + pad, bottomY);

            ctx.restore();
        }

        function drawCenterBadge(cx, cy, radius) {
            ctx.save();
            let bg = '#0c0a09';
            let border = 'rgba(245, 158, 11, 0.5)';
            let textCol = '#fbbf24';
            let label = 'VS';

            if (gameState !== 'playing' && revealFrame >= 105) {
                if (lastGuessCorrect) {
                    bg = '#10b981';
                    border = '#6ee7b7';
                    textCol = '#052e16';
                    label = '✓';
                } else {
                    bg = '#f43f5e';
                    border = '#fda4af';
                    textCol = '#ffffff';
                    label = '✕';
                }
            }

            ctx.fillStyle = bg;
            ctx.shadowColor = 'rgba(0, 0, 0, 0.65)';
            ctx.shadowBlur = 18;
            ctx.beginPath();
            ctx.arc(cx, cy, radius, 0, Math.PI * 2);
            ctx.fill();
            ctx.shadowBlur = 0;

            ctx.strokeStyle = border;
            ctx.lineWidth = 2.5;
            ctx.stroke();

            ctx.fillStyle = textCol;
            ctx.font = `900 ${Math.round(radius * 0.68)}px "JetBrains Mono", monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillText(label, cx, cy + 1);
            ctx.restore();
        }

        /**
         * ============================================================================
         * 8. MODALS, DEBRIEFING & LEADERBOARD MANAGEMENT
         * ============================================================================
         */
        function openLandingModal() {
            playSfx('click');
            document.getElementById('modal-max-depth').innerText = maxDepth + 'm';
            document.getElementById('modal-best-score').innerText = bestScore;
            document.getElementById('modal-total-runs').innerText = totalRuns;
            const modal = document.getElementById('landing-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeLandingModal() {
            ensureAudio();
            playSfx('click');
            const modal = document.getElementById('landing-modal');
            modal.classList.add('hidden');
            modal.classList.remove('block');
        }

        function openCategoryModal() {
            playSfx('click');
            const categories = ["All", "Platforms", "Tech & AI", "Gaming", "Pop Culture", "Brands & Retail", "Utilities"];
            const listEl = document.getElementById('category-list');
            listEl.innerHTML = '';

            categories.forEach(cat => {
                const isSelected = selectedCategory === cat;
                const btn = document.createElement('button');
                btn.className = `p-3 rounded-xl border text-xs font-mono font-bold transition-all flex items-center justify-center gap-2 cursor-pointer ${
                    isSelected
                        ? 'bg-amber-500/20 border-amber-500 text-amber-300 shadow-[0_0_20px_rgba(245,158,11,0.3)]'
                        : 'bg-white/[0.02] border-white/10 text-stone-300 hover:bg-white/[0.06] hover:text-white'
                }`;
                btn.innerHTML = `
                    <span class="w-2 h-2 rounded-full ${isSelected ? 'bg-amber-400' : 'bg-stone-600'}"></span>
                    <span>${cat === "All" ? "All Realms" : cat}</span>
                `;
                btn.onclick = () => {
                    selectedCategory = cat;
                    document.getElementById('hud-category').innerText = cat === "All" ? "All Realms" : cat;
                    closeCategoryModal();
                    initGame();
                };
                listEl.appendChild(btn);
            });

            const modal = document.getElementById('category-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCategoryModal() {
            playSfx('click');
            const modal = document.getElementById('category-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function showGameOverModal() {
            document.getElementById('go-score').innerText = score;
            document.getElementById('go-depth').innerText = depth + 'm';
            document.getElementById('go-best-score').innerText = bestScore;
            document.getElementById('go-max-depth').innerText = maxDepth + 'm';
            document.getElementById('go-total-runs').innerText = totalRuns;

            const recordBadge = document.getElementById('go-new-record-badge');
            if (isNewRecordThisRun) {
                recordBadge.classList.remove('hidden');
            } else {
                recordBadge.classList.add('hidden');
            }

            let strataRank = "Surface Prospector";
            if (depth >= 300) strataRank = "Magma Core Master";
            else if (depth >= 150) strataRank = "Crystal Vault Explorer";
            else if (depth >= 60) strataRank = "Deep Vein Miner";
            document.getElementById('go-strata-rank').innerText = strataRank;

            document.getElementById('go-comparison-summary').innerText = 
                `"${rightItem.title}" had ${rightItem.searches.toLocaleString()} searches, but "${leftItem.title}" had ${leftItem.searches.toLocaleString()}. Your drill seized at ${depth}m!`;

            // Populate Leaderboard list
            const listEl = document.getElementById('go-leaderboard-list');
            listEl.innerHTML = '';
            if (runHistory.length === 0) {
                listEl.innerHTML = '<p class="text-stone-500 italic">No previous dives recorded yet.</p>';
            } else {
                runHistory.slice(0, 5).forEach((run, idx) => {
                    const row = document.createElement('div');
                    row.className = 'flex items-center justify-between bg-white/[0.03] px-3 py-1.5 rounded-xl border border-white/[0.05]';
                    row.innerHTML = `
                        <span class="text-stone-300">#${idx+1} &bull; Streak <strong class="text-white">${run.score}</strong> (${run.depth}m)</span>
                        <span class="text-[10px] text-stone-500">${run.realm}</span>
                    `;
                    listEl.appendChild(row);
                });
            }

            const modal = document.getElementById('gameover-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function restartGame() {
            playSfx('click');
            const modal = document.getElementById('gameover-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
            initGame();
        }

        function copyExpeditionStats() {
            playSfx('click');
            const text = `⛏️ Cinematic Cave Expedition Result\n🏆 Streak: ${score}\n📍 Depth: ${depth}m\n💎 Best Streak: ${bestScore}\n(Max Depth: ${maxDepth}m)`;
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(() => {
                    document.getElementById('go-share-label').innerText = 'Copied!';
                    setTimeout(() => document.getElementById('go-share-label').innerText = 'Share', 2000);
                });
            }
        }

        function launchRealmFromGuide(realmName) {
            selectedCategory = realmName;
            document.getElementById('hud-category').innerText = realmName;
            closeLandingModal();
            initGame();
        }

        window.onload = function () {
            document.getElementById('modal-max-depth').innerText = maxDepth + 'm';
            document.getElementById('modal-best-score').innerText = bestScore;
            document.getElementById('modal-total-runs').innerText = totalRuns;
            requestAnimationFrame(renderLoop);
        };
    </script>
</body>
</html>
