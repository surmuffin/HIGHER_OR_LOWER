    <script>
        /**
         * ============================================================================
         * 1. SYNTHESIZED AUDIO ENGINE (Tone.js)
         * ============================================================================
         */
        let soundEnabled = true;
        let audioInitialized = false;
        let chimeSynth = null;
        let impactSynth = null;

        function ensureAudio() {
            if (!soundEnabled) return;
            if (!audioInitialized && typeof Tone !== 'undefined') {
                try {
                    Tone.start();
                    chimeSynth = new Tone.PolySynth(Tone.Synth, {
                        oscillator: { type: 'triangle' },
                        envelope: { attack: 0.01, decay: 0.18, sustain: 0.05, release: 0.4 }
                    }).toDestination();
                    chimeSynth.volume.value = -8;

                    impactSynth = new Tone.MembraneSynth({
                        pitchDecay: 0.05,
                        octaves: 4,
                        oscillator: { type: 'sine' },
                        envelope: { attack: 0.001, decay: 0.3, sustain: 0.01, release: 0.4 }
                    }).toDestination();
                    impactSynth.volume.value = -6;
                    audioInitialized = true;
                } catch (e) {}
            }
        }

        function playSfx(type) {
            if (!soundEnabled) return;
            ensureAudio();
            if (!audioInitialized) return;
            try {
                const now = Tone.now();
                if (type === 'click') {
                    chimeSynth.triggerAttackRelease('A4', '32n', now);
                } else if (type === 'dig') {
                    impactSynth.triggerAttackRelease('C2', '8n', now);
                    chimeSynth.triggerAttackRelease(['E5', 'G5'], '16n', now + 0.05);
                } else if (type === 'fail') {
                    impactSynth.triggerAttackRelease('G1', '4n', now);
                    chimeSynth.triggerAttackRelease(['Eb3', 'D3'], '8n', now + 0.08);
                }
            } catch (e) {}
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            document.getElementById('icon-sound-on').classList.toggle('hidden', !soundEnabled);
            document.getElementById('icon-sound-off').classList.toggle('hidden', soundEnabled);
            if (soundEnabled) playSfx('click');
        }

        /**
