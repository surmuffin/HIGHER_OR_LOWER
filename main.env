<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Higher or Lower — Subterranean Cave Expedition</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace']
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tone.js for Synthesized Sound Effects -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #040303;
            color: #f5f5f4;
            overflow: hidden;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        .font-mono-num {
            font-family: 'JetBrains Mono', monospace;
            font-variant-numeric: tabular-nums;
        }
        /* Subtle Cinematic Vignette */
        .cinematic-vignette::before {
            content: " ";
            display: block;
            position: fixed;
            inset: 0;
            background: radial-gradient(circle at center, transparent 42%, rgba(0, 0, 0, 0.88) 100%);
            z-index: 15;
            pointer-events: none;
        }
        @keyframes modalPop {
            0% { opacity: 0; transform: scale(0.94) translateY(12px); }
            100% { opacity: 1; transform: scale(1) translateY(0); }
        }
        .animate-modal-pop {
            animation: modalPop 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col bg-[#040303] text-stone-100 relative selection:bg-amber-500/30 selection:text-amber-300 cinematic-vignette">

    <!-- HD Interactive Subterranean Cave Canvas Engine -->
    <canvas id="game-canvas" class="fixed inset-0 z-0 block w-full h-full"></canvas>

    <!-- Top HUD Header Overlay -->
    <header class="relative z-20 w-full px-4 sm:px-6 py-3 sm:py-4 flex items-center justify-between pointer-events-none">
        <!-- Brand Logo -->
        <div class="flex items-center gap-2.5 sm:gap-3 pointer-events-auto cursor-pointer group" onclick="openLandingModal()">
            <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-2xl bg-gradient-to-tr from-amber-500 via-orange-600 to-red-600 flex items-center justify-center shadow-[0_0_25px_rgba(245,158,11,0.5)] group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-stone-950" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
            </div>
            <div>
                <h1 class="font-extrabold text-sm sm:text-base tracking-tight text-white flex items-center gap-1.5 drop-shadow-md">
                    HIGHER <span class="text-amber-400">OR</span> LOWER
                </h1>
                <p id="header-strata" class="text-[10px] font-mono font-bold text-amber-400/90 uppercase tracking-widest drop-shadow">Bedrock Strata • 0m</p>
            </div>
        </div>

        <!-- Telemetry & Controls -->
        <div class="flex items-center gap-2 sm:gap-3 pointer-events-auto">
            <!-- Telemetry Pill -->
            <div class="bg-[#141210]/90 backdrop-blur-xl border border-amber-500/30 px-3 sm:px-4 py-2 rounded-2xl shadow-2xl flex items-center gap-3 sm:gap-4 font-mono">
                <div class="text-center">
                    <span class="text-[9px] text-stone-400 uppercase block font-semibold">Depth</span>
                    <span id="hud-depth" class="text-xs sm:text-sm font-black text-amber-400">0m</span>
                </div>
                <div class="w-[1px] h-6 bg-amber-500/20"></div>
                <div class="text-center">
                    <span class="text-[9px] text-stone-400 uppercase block font-semibold">Streak</span>
                    <span id="hud-score" class="text-xs sm:text-sm font-black text-white">0</span>
                </div>
                <div class="hidden sm:block w-[1px] h-6 bg-amber-500/20"></div>
                <div class="hidden sm:block text-center">
                    <span class="text-[9px] text-stone-400 uppercase block font-semibold">Best</span>
                    <span id="hud-best" class="text-xs sm:text-sm font-black text-emerald-400">0</span>
                </div>
            </div>

            <!-- Category Selector Button -->
            <button onclick="openCategoryModal()" class="px-3 py-2.5 rounded-xl bg-[#141210]/90 hover:bg-[#1c1917] border border-amber-500/30 text-amber-400 text-xs font-bold transition-all shadow-xl cursor-pointer flex items-center gap-1.5" title="Select Category">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path></svg>
                <span id="hud-category" class="hidden md:inline">All Realms</span>
            </button>

            <!-- Sound Toggle Button -->
            <button onclick="toggleSound()" id="sound-btn" class="w-10 h-10 rounded-xl bg-[#141210]/90 hover:bg-[#1c1917] border border-stone-800 flex items-center justify-center text-stone-300 hover:text-white transition-all shadow-xl cursor-pointer" title="Toggle Audio">
                <svg id="icon-sound-on" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path></svg>
                <svg id="icon-sound-off" class="w-4 h-4 hidden text-rose-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg>
            </button>
        </div>
    </header>

    <!-- Bottom Keyboard Hint Bar -->
    <footer class="fixed bottom-3 left-0 right-0 z-20 pointer-events-none flex justify-center px-4">
        <div class="bg-[#141210]/80 backdrop-blur-md border border-white/10 px-4 py-1.5 rounded-full text-[11px] font-mono text-stone-400 flex items-center gap-3 shadow-lg">
            <span>Click canvas buttons or use</span>
            <span class="px-1.5 py-0.5 rounded bg-white/10 text-amber-300 font-bold">↑ Higher</span>
            <span class="px-1.5 py-0.5 rounded bg-white/10 text-rose-300 font-bold">↓ Lower</span>
        </div>
    </footer>

    <!-- BRIEFING / LANDING MODAL -->
    <div id="landing-modal" class="fixed inset-0 z-50 bg-[#070504]/95 backdrop-blur-2xl overflow-y-auto">
        <div class="min-h-screen w-full max-w-4xl mx-auto px-4 sm:px-8 py-8 sm:py-12 flex flex-col gap-10 animate-modal-pop">
            
            <!-- HERO SECTION -->
            <section class="relative bg-[#141210] border border-amber-500/35 rounded-3xl p-6 sm:p-10 shadow-[0_0_80px_rgba(245,158,11,0.25)] text-center space-y-6 overflow-hidden">
                <!-- Ambient Top Glow -->
                <div class="absolute -top-28 left-1/2 -translate-x-1/2 w-96 h-56 bg-amber-500/20 blur-3xl pointer-events-none"></div>

                <!-- High-Detail Custom Subterranean Cavern & Pickaxe Emblem SVG -->
                <div class="relative mx-auto w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-gradient-to-b from-[#1e1915] to-[#0c0a09] border border-amber-400/40 shadow-[0_0_45px_rgba(245,158,11,0.45)] flex items-center justify-center overflow-hidden">
                    <svg class="w-full h-full" viewBox="0 0 160 160" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <radialGradient id="cavernGlow" cx="50%" cy="42%" r="55%">
                                <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.45"/>
                                <stop offset="55%" stop-color="#ea580c" stop-opacity="0.15"/>
                                <stop offset="100%" stop-color="#090707" stop-opacity="0"/>
                            </radialGradient>
                            <linearGradient id="crystalCyan" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#7dd3fc"/>
                                <stop offset="100%" stop-color="#0284c7"/>
                            </linearGradient>
                            <linearGradient id="crystalViolet" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#d8b4fe"/>
                                <stop offset="100%" stop-color="#7e22ce"/>
                            </linearGradient>
                            <linearGradient id="pickSteel" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#f8fafc"/>
                                <stop offset="50%" stop-color="#cbd5e1"/>
                                <stop offset="100%" stop-color="#64748b"/>
                            </linearGradient>
                            <linearGradient id="pickHandle" x1="0%" y1="0%" x2="100%" y2="100%">
                                <stop offset="0%" stop-color="#f59e0b"/>
                                <stop offset="100%" stop-color="#92400e"/>
                            </linearGradient>
                        </defs>

                        <rect width="160" height="160" fill="#0c0a09"/>
                        <circle cx="80" cy="68" r="74" fill="url(#cavernGlow)"/>

                        <path d="M0 160V48C22 34 48 22 80 22C112 22 138 34 160 48V160H0Z" fill="#171311"/>
                        <path d="M0 160V72C26 52 52 42 80 42C108 42 134 52 160 72V160H0Z" fill="#100d0c"/>

                        <polygon points="34,24 44,24 39,50" fill="#29221e"/>
                        <polygon points="114,24 126,24 120,54" fill="#29221e"/>
                        <polygon points="74,22 86,22 80,44" fill="#1f1916"/>

                        <polygon points="22,126 32,88 44,126" fill="url(#crystalCyan)"/>
                        <polygon points="36,132 48,102 58,132" fill="#38bdf8" opacity="0.85"/>
                        <polygon points="14,132 23,106 31,132" fill="#0369a1"/>

                        <polygon points="118,128 130,86 142,128" fill="url(#crystalViolet)"/>
                        <polygon points="104,132 115,104 125,132" fill="#a855f7" opacity="0.85"/>
                        <polygon points="132,134 143,108 150,134" fill="#6b21a8"/>

                        <path d="M44 142C52 122 66 114 80 114C94 114 108 122 116 142H44Z" fill="#292018"/>
                        <circle cx="68" cy="128" r="3.5" fill="#fbbf24"/>
                        <circle cx="84" cy="124" r="4" fill="#f59e0b"/>
                        <circle cx="94" cy="132" r="3" fill="#fde047"/>

                        <g transform="translate(80, 74) rotate(-38)">
                            <rect x="-4" y="-34" width="8" height="76" rx="4" fill="url(#pickHandle)"/>
                            <rect x="-4" y="-34" width="3" height="76" rx="1.5" fill="#fcd34d" opacity="0.35"/>
                            <path d="M-36 -18C-16 -30 16 -30 36 -18L32 -10C14 -19 -14 -19 -32 -10L-36 -18Z" fill="url(#pickSteel)"/>
                            <rect x="-7" y="-27" width="14" height="11" rx="2.5" fill="#475569"/>
                        </g>

                        <circle cx="54" cy="54" r="2.2" fill="#fde047"/>
                        <circle cx="108" cy="58" r="2" fill="#7dd3fc"/>
                        <circle cx="80" cy="46" r="1.8" fill="#fbbf24"/>
                    </svg>
                </div>

                <!-- Title & Subtitle -->
                <div class="space-y-2.5 relative z-10">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-[10px] font-mono font-bold uppercase tracking-widest">
                        <span>Subterranean Search Volume Expedition • 130+ Verified Subjects</span>
                    </div>
                    <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
                        HIGHER <span class="text-amber-400">OR</span> LOWER
                    </h2>
                    <p class="text-xs sm:text-base text-stone-300 leading-relaxed font-mono max-w-2xl mx-auto">
                        Test your intuition against real-world global monthly search metrics. Every accurate comparison swings your pickaxe, triggers seismic sparks, and drives your expedition deeper beneath the Earth's crust.
                    </p>
                </div>

                <!-- Persistent Career Telemetry -->
                <div class="grid grid-cols-3 gap-3 sm:gap-4 text-center bg-white/[0.02] border border-white/[0.07] p-4 rounded-2xl font-mono text-xs relative z-10 max-w-xl mx-auto">
                    <div>
                        <span class="block text-[10px] text-stone-500 uppercase font-semibold">Max Depth</span>
                        <span id="modal-max-depth" class="text-lg sm:text-2xl font-black text-amber-400">0m</span>
                    </div>
                    <div>
                        <span class="block text-[10px] text-stone-500 uppercase font-semibold">Best Streak</span>
                        <span id="modal-best-score" class="text-lg sm:text-2xl font-black text-emerald-400">0</span>
                    </div>
                    <div>
                        <span class="block text-[10px] text-stone-500 uppercase font-semibold">Expeditions</span>
                        <span id="modal-total-runs" class="text-lg sm:text-2xl font-black text-sky-400">0</span>
                    </div>
                </div>

                <!-- Primary CTA & Realm Picker -->
                <div class="flex flex-col sm:flex-row gap-3 relative z-10 max-w-xl mx-auto pt-1">
                    <button onclick="closeLandingModal()" class="flex-1 py-4 px-6 rounded-2xl bg-gradient-to-r from-amber-500 via-orange-600 to-red-600 hover:from-amber-400 hover:to-orange-500 text-stone-950 font-extrabold text-sm sm:text-base transition-all shadow-[0_0_30px_rgba(245,158,11,0.45)] cursor-pointer">
                        Enter Cavern & Start Drilling
                    </button>
                    <button onclick="openCategoryModal()" class="py-4 px-6 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/15 text-stone-200 font-bold text-xs sm:text-sm transition-all cursor-pointer">
                        Choose Realm
                    </button>
                </div>

                <!-- Scroll Indicator -->
                <div class="pt-2 flex flex-col items-center gap-1 text-stone-500 text-[11px] font-mono">
                    <span>Scroll down to read the Expedition Field Manual</span>
                    <span class="animate-bounce text-amber-400">↓</span>
                </div>
            </section>

            <!-- SECTION 2: HOW TO PLAY & MECHANICS -->
            <section class="bg-[#141210]/90 border border-white/10 rounded-3xl p-6 sm:p-8 space-y-6">
                <div class="space-y-1">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-amber-400">01 // Field Protocol</span>
                    <h3 class="text-xl sm:text-2xl font-black text-white">How the Expedition Works</h3>
                    <p class="text-xs sm:text-sm text-stone-400 font-mono">Master the subterranean comparison loop to survive deep-earth strata.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 font-mono">
                    <div class="bg-white/[0.02] border border-white/[0.06] rounded-2xl p-5 space-y-2.5">
                        <div class="w-9 h-9 rounded-xl bg-amber-500/15 border border-amber-500/30 text-amber-400 font-black flex items-center justify-center text-sm">1</div>
                        <h4 class="text-sm font-extrabold text-white">Inspect Baseline Volume</h4>
                        <p class="text-xs text-stone-400 leading-relaxed">
                            The left cavern card reveals a real-world subject and its verified average global monthly search count.
                        </p>
                    </div>
                    <div class="bg-white/[0.02] border border-white/[0.06] rounded-2xl p-5 space-y-2.5">
                        <div class="w-9 h-9 rounded-xl bg-sky-500/15 border border-sky-500/30 text-sky-400 font-black flex items-center justify-center text-sm">2</div>
                        <h4 class="text-sm font-extrabold text-white">Predict Higher or Lower</h4>
                        <p class="text-xs text-stone-400 leading-relaxed">
                            Decide whether the right-hand subject receives <span class="text-amber-300 font-bold">▲ HIGHER</span> or <span class="text-rose-300 font-bold">▼ LOWER</span> monthly searches using mouse, touch, or <span class="text-white">↑ / ↓</span> keys.
                        </p>
                    </div>
                    <div class="bg-white/[0.02] border border-white/[0.06] rounded-2xl p-5 space-y-2.5">
                        <div class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-black flex items-center justify-center text-sm">3</div>
                        <h4 class="text-sm font-extrabold text-white">Strike & Descend</h4>
                        <p class="text-xs text-stone-400 leading-relaxed">
                            Each right call swings your pickaxe, adds <span class="text-amber-300">+24m to +37m</span> of depth, and advances the right card into the next round.
                        </p>
                    </div>
                </div>
            </section>

            <!-- SECTION 3: SUBTERRANEAN STRATA & BIOMES -->
            <section class="bg-[#141210]/90 border border-white/10 rounded-3xl p-6 sm:p-8 space-y-6">
                <div class="space-y-1">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-sky-400">02 // Geological Layers</span>
                    <h3 class="text-xl sm:text-2xl font-black text-white">Subterranean Strata & Rank Tiers</h3>
                    <p class="text-xs sm:text-sm text-stone-400 font-mono">The cavern atmosphere, mineral veins, and lighting dynamically shift as you descend deeper.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono">
                    <div class="bg-amber-500/[0.06] border border-amber-500/25 rounded-2xl p-5 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-amber-400 uppercase">0m – 59m • Bedrock Strata</span>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-amber-500/20 text-amber-300">Tier I</span>
                        </div>
                        <p class="text-xs text-stone-300 leading-relaxed">
                            Upper sedimentary crust lit by warm miner headlamp beams and amber mineral dust motes.
                        </p>
                    </div>

                    <div class="bg-purple-500/[0.06] border border-purple-500/25 rounded-2xl p-5 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-purple-400 uppercase">60m – 149m • Deep Ore Vein</span>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-purple-500/20 text-purple-300">Tier II</span>
                        </div>
                        <p class="text-xs text-stone-300 leading-relaxed">
                            Dense violet quartz formations and rich subterranean mineral deposits begin emerging along cavern walls.
                        </p>
                    </div>

                    <div class="bg-sky-500/[0.06] border border-sky-500/25 rounded-2xl p-5 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-sky-400 uppercase">150m – 299m • Crystal Cavern</span>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-sky-500/20 text-sky-300">Tier III</span>
                        </div>
                        <p class="text-xs text-stone-300 leading-relaxed">
                            Bioluminescent cyan crystal vaults illuminate deep tectonic chambers with cool cerulean luminescence.
                        </p>
                    </div>

                    <div class="bg-rose-500/[0.06] border border-rose-500/25 rounded-2xl p-5 space-y-1.5">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-black text-rose-400 uppercase">300m+ • Magma Core Abyss</span>
                            <span class="text-[10px] px-2 py-0.5 rounded bg-rose-500/20 text-rose-300">Tier IV</span>
                        </div>
                        <p class="text-xs text-stone-300 leading-relaxed">
                            Extreme geothermal pressure and glowing crimson magma strata reserved for elite prospectors.
                        </p>
                    </div>
                </div>
            </section>

            <!-- SECTION 4: EXPLORE THE 6 KNOWLEDGE REALMS -->
            <section class="bg-[#141210]/90 border border-white/10 rounded-3xl p-6 sm:p-8 space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
                    <div class="space-y-1">
                        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-emerald-400">03 // Curated Search Database</span>
                        <h3 class="text-xl sm:text-2xl font-black text-white">6 Specialized Mining Realms</h3>
                        <p class="text-xs sm:text-sm text-stone-400 font-mono">Play across all 130+ subjects combined or drill into a specific category.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5 font-mono">
                    <button onclick="launchRealmFromGuide('Platforms')" class="text-left p-4 rounded-2xl bg-white/[0.02] hover:bg-sky-500/10 border border-white/10 hover:border-sky-400/40 transition-all cursor-pointer space-y-1.5 group">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-sky-400">Platforms & Social</span>
                            <span class="text-[10px] text-stone-500 group-hover:text-sky-300">Play →</span>
                        </div>
                        <p class="text-[11px] text-stone-400">Google, YouTube, TikTok, Instagram, WhatsApp, Reddit, Twitch, Wikipedia & more.</p>
                    </button>

                    <button onclick="launchRealmFromGuide('Tech & AI')" class="text-left p-4 rounded-2xl bg-white/[0.02] hover:bg-emerald-500/10 border border-white/10 hover:border-emerald-400/40 transition-all cursor-pointer space-y-1.5 group">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-emerald-400">Tech, AI & Science</span>
                            <span class="text-[10px] text-stone-500 group-hover:text-emerald-300">Play →</span>
                        </div>
                        <p class="text-[11px] text-stone-400">ChatGPT, Apple, Bitcoin, Nvidia, NASA, Python, Linux, PlayStation & more.</p>
                    </button>

                    <button onclick="launchRealmFromGuide('Gaming')" class="text-left p-4 rounded-2xl bg-white/[0.02] hover:bg-purple-500/10 border border-white/10 hover:border-purple-400/40 transition-all cursor-pointer space-y-1.5 group">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-purple-400">Video Games</span>
                            <span class="text-[10px] text-stone-500 group-hover:text-purple-300">Play →</span>
                        </div>
                        <p class="text-[11px] text-stone-400">Roblox, Minecraft, Fortnite, GTA 5, League of Legends, Valorant, Elden Ring & more.</p>
                    </button>

                    <button onclick="launchRealmFromGuide('Pop Culture')" class="text-left p-4 rounded-2xl bg-white/[0.02] hover:bg-amber-500/10 border border-white/10 hover:border-amber-400/40 transition-all cursor-pointer space-y-1.5 group">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-extrabold text-amber-400">Pop Culture & Sports</span>
                            <span class="text-[10px] text-stone-500 group-hover:text-amber-300">Play →</span>
                        </div>
