                    <button onclick="closeLandingModal()" class="w-full sm:w-auto py-3.5 px-8 rounded-2xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-stone-950 font-extrabold text-sm transition-all shadow-[0_0_25px_rgba(245,158,11,0.4)] cursor-pointer shrink-0">
